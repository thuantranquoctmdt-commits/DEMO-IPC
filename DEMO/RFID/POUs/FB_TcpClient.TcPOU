<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.16">
  <POU Name="FB_TcpClient" Id="{0499ef87-5436-45e5-809a-d9b15017e94d}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_TcpClient IMPLEMENTS I_TcpClient
VAR_INPUT
END_VAR
VAR_OUTPUT
END_VAR
VAR
	fbConnect    : FB_SocketConnect;
    fbReceive    : FB_SocketReceive;
    hSocket      : T_HSOCKET;
    
    nState       : INT;
    bCmdConnect  : BOOL;
	sTargetIP	  : STRING;
	nTargetPort	: UINT;
    
    arrBuffer    : ARRAY[0..255] OF BYTE;
    nRxBytes     : UDINT;
    bDataReady   : BOOL;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="M_Connect" Id="{bad03c59-13d8-4e8f-b38a-2ccad48128f5}">
      <Declaration><![CDATA[{warning 'add method implementation '}
METHOD M_Connect
VAR_INPUT
	sIP	    : STRING;
	nPort	: UINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[sTargetIP := sIP;
nTargetPort := nPort;
bCmdConnect := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_Cyclic" Id="{c5d5b43a-00da-41c3-a07f-3125d3b2eeb6}">
      <Declaration><![CDATA[{warning 'add method implementation '}
METHOD M_Cyclic
]]></Declaration>
      <Implementation>
        <ST><![CDATA[CASE nState OF
    0: 
        IF bCmdConnect THEN
            bCmdConnect := FALSE;
            nState := 10;
        END_IF
        
    10: 
        fbConnect(sSrvNetId := '', sRemoteHost := sTargetIP, nRemotePort := nTargetPort, bExecute := TRUE, tTimeout := T#3S);
        IF NOT fbConnect.bBusy THEN
            IF NOT fbConnect.bError THEN
                hSocket := fbConnect.hSocket;
                nState := 20; 
            ELSE
                nState := 99; 
            END_IF
            fbConnect(bExecute := FALSE);
        END_IF
          
    20: 
        IF NOT fbReceive.bBusy THEN
            fbReceive.bExecute := TRUE;
        END_IF
        
        fbReceive(sSrvNetId := '', hSocket := hSocket, cbLen := SIZEOF(arrBuffer), pDest := ADR(arrBuffer), tTimeout := T#1S);
        
        IF NOT fbReceive.bBusy AND fbReceive.bExecute THEN
            IF NOT fbReceive.bError AND fbReceive.nRecBytes > 0 THEN
                nRxBytes := fbReceive.nRecBytes;
                bDataReady := TRUE; 
            END_IF
            fbReceive.bExecute := FALSE; 
            fbReceive(); 
        END_IF
END_CASE]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_GetData" Id="{594b4c60-18e7-416e-96c1-0beaa64c1dc0}">
      <Declaration><![CDATA[{warning 'add method implementation '}
METHOD M_GetData : UDINT;
VAR_INPUT
	pDest	: POINTER TO BYTE;
	nSize	: UDINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF bDataReady THEN
    MEMCPY(destAddr := pDest, srcAddr := ADR(arrBuffer), n := MIN(nSize, nRxBytes));
    M_GetData  := nRxBytes;
    bDataReady := FALSE;
ELSE
    M_GetData := 0;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Property Name="P_HasNewData" Id="{af66b793-ccae-4d7a-9e7d-810f71651848}">
      <Declaration><![CDATA[{warning 'add property implementation'}
PROPERTY P_HasNewData : BOOL
]]></Declaration>
      <Get Name="Get" Id="{8b6beffc-8c4a-4acb-9aa6-5433c74fa5b6}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[P_HasNewData := bDataReady;]]></ST>
        </Implementation>
      </Get>
    </Property>
